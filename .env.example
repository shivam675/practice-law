# ---------- core ----------
APP_ENV=development
LOG_LEVEL=debug

# ---------- api ----------
API_HTTP_ADDR=:8080
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:5173
# comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- postgres ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=megamoot
POSTGRES_PASSWORD=megamoot_dev_password
POSTGRES_DB=megamoot
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://megamoot:megamoot_dev_password@postgres:5432/megamoot?sslmode=disable

# ---------- redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- object storage ----------
# filesystem (development) | s3 (production, any S3-compatible endpoint)
BLOB_DRIVER=filesystem
BLOB_FS_ROOT=/var/lib/megamoot/blobs
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=megamoot
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ---------- auth ----------
# generate: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_dev_only_do_not_use_in_production_0000000000
# Seals model provider credentials in the database. 32 bytes, base64 or hex.
# Generate: openssl rand -base64 32
# Rotating this without re-entering each provider API key makes the stored
# keys unreadable; the settings page says so rather than blaming the provider.
CONFIG_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1rZXktZG8tbm90LXVzZSE=

ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------- ai plane ----------
AI_SERVICE_URL=http://ai:8100
# Authenticates the control plane to the AI plane. Generate: openssl rand -hex 32
AI_SERVICE_TOKEN=dev_ai_service_token_change_me
MEDIA_SERVICE_URL=http://media:8200
MEDIA_PUBLIC_WS_URL=ws://localhost:8400
# Host port for the media plane. 8200 collides with the Windows/Hyper-V reserved
# range; check with: netsh interface ipv4 show excludedportrange protocol=tcp
MEDIA_HOST_PORT=8400

# ---------- model providers ----------
# Providers and per-tier model bindings are rows in model_providers and
# model_bindings, edited by a platform operator at /admin/models. There is
# nothing to set here: a provider URL and bearer token in a .env file cannot
# be rotated without a deploy, which is the problem the settings page solves.

# ---------- speech ----------
STT_PROVIDER=faster_whisper
STT_MODEL=small.en
# cuda needs a CUDA base image for apps/media; the shipped one is CPU-only.
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8_float16
# Latency knobs. A long pause ends a turn; the text on screen refreshes far faster.
STT_END_SILENCE_SECONDS=1.2
STT_PARTIAL_INTERVAL_SECONDS=0.6
STT_SETTLE_AFTER_SECONDS=8
STT_MAX_TURN_SECONDS=8
STT_BEAM_SIZE=3
TTS_PROVIDER=paradee
# Paradee speaks one voice (af_heart). Speed only.
TTS_SPEED=1.0

# ---------- capacity ----------
# hard ceiling on simultaneous live sessions on this GPU box
MAX_CONCURRENT_LIVE_SESSIONS=4

# ---------- seed (development only) ----------
SEED_ORG_NAME=Demo Law School
SEED_ADMIN_EMAIL=admin@demo.test
SEED_ADMIN_PASSWORD=ChangeMe123!

# Platform operator. Holds every permission, including the platform ones no
# organisation role can be granted. Development only: refused in production
# unless at least 16 characters.
SEED_SUPERADMIN_EMAIL=suadmin
SEED_SUPERADMIN_PASSWORD=admin123

# Demo teacher and two students, plus a two-speaker team of the right shape.
# Unset to skip. Refused in production.
SEED_DEMO_PASSWORD=student123
# Local speech. Set a unique value outside development.
MEDIA_SERVICE_TOKEN=local_speech_development_only_change_me
STT_MODEL=small.en
