# ---------- core ----------
APP_ENV=development
LOG_LEVEL=debug

# ---------- api ----------
API_HTTP_ADDR=:8080
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:5173
# comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- postgres ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=megamoot
POSTGRES_PASSWORD=megamoot_dev_password
POSTGRES_DB=megamoot
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://megamoot:megamoot_dev_password@postgres:5432/megamoot?sslmode=disable

# ---------- redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- object storage ----------
# filesystem (development) | s3 (production, any S3-compatible endpoint)
BLOB_DRIVER=filesystem
BLOB_FS_ROOT=/var/lib/megamoot/blobs
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=megamoot
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ---------- auth ----------
# generate: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_dev_only_do_not_use_in_production_0000000000
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------- ai plane ----------
AI_SERVICE_URL=http://ai:8100
MEDIA_SERVICE_URL=http://media:8200
MEDIA_PUBLIC_WS_URL=ws://localhost:8200

# ---------- model providers ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL_MONITOR=qwen3:4b
LLM_MODEL_JUDGE=qwen3:8b
LLM_MODEL_GRADER=qwen3:30b-a3b
LLM_TIMEOUT_MONITOR=2s
LLM_TIMEOUT_JUDGE=3s

# ---------- speech ----------
STT_PROVIDER=faster_whisper
STT_MODEL=small.en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
TTS_PROVIDER=kokoro
TTS_VOICE=bm_george

# ---------- capacity ----------
# hard ceiling on simultaneous live sessions on this GPU box
MAX_CONCURRENT_LIVE_SESSIONS=4

# ---------- seed (development only) ----------
SEED_ORG_NAME=Demo Law School
SEED_ADMIN_EMAIL=admin@demo.test
SEED_ADMIN_PASSWORD=ChangeMe123!
